# Canonical configuration for the external result interpreter.
AXION_EXTERNAL_DATA_POLICY=DISABLED
AXION_RESULT_INTERPRETER_PROVIDER=openai
AXION_RESULT_INTERPRETER_MODEL=
# OPENAI_API_KEY is resolved separately from environment or Streamlit secrets.
# Legacy KOMUS_EXTERNAL_DATA_POLICY, KOMUS_RESULT_INTERPRETER_PROVIDER and
# KOMUS_RESULT_INTERPRETER_MODEL remain supported when AXION_* is not supplied.
